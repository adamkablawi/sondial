# ─── Frontend (Vercel) ───────────────────────────────────────────────
# The anon key is safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Worker (Vultr) — all secret, never NEXT_PUBLIC_ ─────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Providers. Both default to `mock`, so the whole app runs with no keys.
MESH_PROVIDER=mock          # mock | meshy
LLM_PROVIDER=mock           # mock | anthropic | grok

# Meshy — https://meshy.ai
MESHY_API_KEY=

# Anthropic Claude. Run `npm run verify:llm` with LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# xAI Grok. Run `npm run verify:grok` to confirm these ids work with your key.
XAI_API_KEY=
GROK_TEXT_MODEL=grok-4.6
GROK_VISION_MODEL=grok-4.6

# Safety rail on finite Meshy credits.
MAX_VERSIONS_PER_ROOM=20
