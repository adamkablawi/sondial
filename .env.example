# Copy to .env (or .env.local) and fill in what you need.
#
# Everything defaults to mock providers, so the whole stack runs end-to-end
# with no API keys at all. Add keys only for the pieces you want to be real.
#
# Precedence for the standalone processes (server/env.ts) mirrors Next:
#   shell environment > .env.local > .env

# ── Local infrastructure ──────────────────────────────────────────────
# Two supported setups; pick one and make these match it.
#
#   npm run infra:docker:up  -> docker-compose, ports shifted off the
#                               defaults to avoid collisions (5433 / 6380)
#   npm run infra:brew:up    -> native Homebrew Postgres + Redis on the
#                               default ports (5432 / 6379)
#
# Defaults below are the docker-compose ports. For a native/Homebrew or
# Postgres.app setup use, e.g.:
#   DATABASE_URL=postgresql://<you>@localhost:5432/sondial
#   REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://sondial:sondial@localhost:5433/sondial
REDIS_URL=redis://localhost:6380

# ── Process wiring ────────────────────────────────────────────────────
# Socket.IO server port, and the URL the browser connects to.
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# For LAN/tunnel access this is usually better left unset entirely — the
# client then derives the socket host from the page URL itself. `npm run
# dev:tunnel` manages this variable automatically; don't set it by hand
# unless you're wiring up something other than that script.

# ── Providers ─────────────────────────────────────────────────────────
# Selected by name; `mock` is the universal no-key fallback.
MESH_PROVIDER=mock          # mock | meshy | huggingface
IMAGE_PROVIDER=mock         # mock | huggingface

# Meshy AI — generative mesh generation (MESH_PROVIDER=meshy).
MESHY_API_KEY=
# meshy-6-lite | meshy-6 | meshy-7 | meshy-t2 — lite is fastest (verified:
# ~33s vs ~80-140s for meshy-6 on the same prompt/polycount).
# MESHY_AI_MODEL=meshy-6-lite
# Lower is faster (unconfirmed by Meshy's docs, but a reasonable lever);
# defaults to 10000, down from Meshy's typical 30000.
# MESHY_TARGET_POLYCOUNT=10000


# HuggingFace — image generation, and the stub mesh provider.
HF_API_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_ENDPOINT=

# ── LLM (design-state compilation + instruction classification) ────────
# Without a key the worker falls back to deterministic, non-LLM compilation,
# so this is optional. LLM_PROVIDER defaults to whichever key is present.
LLM_PROVIDER=               # anthropic | gemini | mock

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
