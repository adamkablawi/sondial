# Copy to .env and fill in. Everything defaults to mock providers, so the
# whole stack runs end-to-end with no API keys at all.

# ── Local infrastructure ──
# Ports match docker-compose.yml (shifted off the defaults to avoid collisions).
DATABASE_URL=postgresql://sondial:sondial@localhost:5433/sondial
REDIS_URL=redis://localhost:6380

# ── Process wiring ──
# Socket.IO server port, and the URL the browser connects to.
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# ── Providers ──
# CAD_PROVIDER picks the pipeline:
#   zoo  — parametric KCL; edits the previous version's source precisely
#   mesh — the mesh stack below (default, so no Zoo key is required)
CAD_PROVIDER=mesh

MESH_PROVIDER=mock          # meshy | huggingface | mock
IMAGE_PROVIDER=mock         # huggingface | mock

# Zoo (zoo.dev) — parametric CAD via the Zookeeper copilot websocket
ZOO_API_KEY=

# Meshy AI (mesh generation)
MESHY_API_KEY=

# HuggingFace (image generation)
HF_API_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_ENDPOINT=

# OpenAI (design-state compilation + instruction classification)
# Without this the worker falls back to deterministic, non-LLM compilation.
OPENAI_API_KEY=
